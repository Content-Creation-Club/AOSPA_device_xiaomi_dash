+    @GuardedBy("mGlobalLock")
+    void notifyResumedActivityChanged(ActivityRecord activity, boolean resumed) {
+        if (resumed && !captureResumedActivityIdentity(activity)) return;
+        for (int i = 0; i < mResumedActivityListeners.size(); i++) {
+            notifyResumedActivityChanged(mResumedActivityListeners.get(i), activity, resumed);
+        }
+        if (!resumed) {
+            activity.mResumedActivityPid = 0;
+            activity.mResumedActivityUid = 0;
+        }
+    }
+
+    private boolean captureResumedActivityIdentity(ActivityRecord activity) {
+        if (activity.app == null) return false;
+        final int pid = activity.app.getPid();
+        if (pid <= 0) return false;
+        if (activity.mResumedActivityPid <= 0) {
+            activity.mResumedActivityPid = pid;
+            activity.mResumedActivityUid = activity.getUid();
+        }
+        return true;
+    }
+
+    private void notifyResumedActivityChanged(
+            ActivityTaskManagerInternal.ResumedActivityListener listener, ActivityRecord activity,
+            boolean resumed) {
+        if (activity.mResumedActivityPid <= 0) return;
+        listener.onResumedActivityChanged(activity.mActivityComponent, activity.mResumedActivityPid,
+                activity.mResumedActivityUid, System.identityHashCode(activity), resumed);
+    }
