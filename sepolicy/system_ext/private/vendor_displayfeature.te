# The retained stock vendor policy owns these types. Redeclare them for
# brightness, eye care and thermal clients, as with vendor_displayfeature_device.
type vendor_hal_displayfeature_xiaomi_default, domain;
type vendor_hal_displayfeature_xiaomi_service, service_manager_type, hal_service_type;

# system_server clients call the HAL; brightness also receives callbacks.
allow system_server vendor_hal_displayfeature_xiaomi_service:service_manager find;
binder_call(system_server, vendor_hal_displayfeature_xiaomi_default)
binder_call(vendor_hal_displayfeature_xiaomi_default, system_server)
