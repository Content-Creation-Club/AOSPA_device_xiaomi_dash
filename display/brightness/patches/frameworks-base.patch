+package com.android.server.display;
+
+import java.io.PrintWriter;
+
+/**
+ * Device ambient estimator, called only on the automatic brightness handler.
+ * The controller retains sensor ownership, the evaluation timer, mapping and short-term model.
+ * Implementations must not subscribe in their constructor. All times here are uptime millis.
+ * @hide
+ */
+public interface DeviceAmbientPolicy {
+    /** ABC-side sink used by the policy's independent assist timer. */
+    interface Callbacks {
+        void applyAmbientLux(int event, float lux, boolean needUpdateLux,
+                boolean needUpdateBrightness, float mainThresholdLux);
+        void reportFailure(RuntimeException failure);
+        float getAmbientLux();
+    }
+
+    /** Optional device threshold contract; ABC still owns threshold timing and application. */
+    record Thresholds(float brightening, float smallBrightening, float darkening,
+            long smallBrighteningDebounceMillis) {}
+
+    void start(long uptimeMillis);
+    void stop();
+    /** Receives ABC-owned main estimates; the policy returns arbitration flags only. */
+    default Evaluation onMainAmbientLux(long uptimeMillis, float mainSlowLux, float mainFastLux,
+            float mainBrighteningThreshold, float mainSmallBrighteningThreshold,
+            float mainDarkeningThreshold, long nextBrighteningTransition,
+            long nextDarkeningTransition, boolean initial) {
+        return new Evaluation(0, Float.NaN, false, false, Float.NaN, null);
+    }
+    /** Installs the callback used only for assist-channel decisions. */
+    default void setCallbacks(Callbacks callbacks) {}
+    default Thresholds getMainThresholds(float lux) { return null; }
+    /** Runs on the dumpsys thread; implementations must dump from an immutable snapshot. */
+    default void dump(PrintWriter writer) {}
+
+    /** NaN lux retains the current estimate. */
+    final class Evaluation {
+        public final int event;
+        public final float lux;
+        public final boolean needUpdateLux;
+        public final boolean needUpdateBrightness;
+        public final float mainThresholdLux;
+        public final String reason;
+
+        public Evaluation(int event, float lux, boolean needUpdateLux,
+                boolean needUpdateBrightness, float mainThresholdLux, String reason) {
+            this.event = event;
+            this.lux = lux;
+            this.needUpdateLux = needUpdateLux;
+            this.needUpdateBrightness = needUpdateBrightness;
+            this.mainThresholdLux = mainThresholdLux;
+            this.reason = reason;
+        }
+    }
+}
