type dash_health, coredomain, domain;
type dash_health_exec, system_file_type, exec_type, file_type;

type dash_health_data_file, file_type, data_file_type, core_data_file_type;

# sysfs_batteryinfo comes from AOSP system/sepolicy/public/file.te; a bare
# redeclaration here is a duplicate-type error, unlike the dash_led.te pattern.

init_daemon_domain(dash_health)
hal_server_domain(dash_health, hal_lineage_health)

# addService goes through servicemanager; see dash_livedisplay.te for why
# hal_server_domain alone is not enough on this branch.
binder_call(dash_health, servicemanager)

# NDK binder opens /sys/kernel/tracing/trace_marker on the first transaction.
dontaudit dash_health self:capability { dac_override dac_read_search };

# Keep vendor labels so existing MiCharge/thermal clients retain access.
allow dash_health sysfs_battery_supply:file { getattr open read write };
allow dash_health sysfs_batteryinfo:dir search;
allow dash_health sysfs_battery_supply:dir search;

# Retained vendor type for thermal_message/charger_temp.
type sysfs_therm;
allow dash_health sysfs_therm:dir search;
allow dash_health sysfs_therm:file { getattr open read write };
allow dash_health sysfs_usb_supply:dir search;
allow dash_health sysfs_usb_supply:file { getattr open read };
allow dash_health self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;

allow dash_health dash_health_data_file:dir rw_dir_perms;
allow dash_health dash_health_data_file:file create_file_perms;
